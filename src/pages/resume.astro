    };

    const tabs = document.querySelectorAll('[data-variant-tab]');
    const variants = document.querySelectorAll('.resume-variant');
    const subtitle = document.querySelector('[data-variant-subtitle]');

    function selectVariant(v) {
        variants.forEach((el) => {
            el.classList.toggle('hidden', el.dataset.variant !== v);
        });
        tabs.forEach((tab) => {
            const active = tab.dataset.variantTab === v;
            tab.classList.toggle('bg-ink', active);
            tab.classList.toggle('text-bg', active);
            tab.classList.toggle('text-fontPrimary/70', !active);
            tab.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        if (subtitle) subtitle.textContent = variantConfig[v].subtitle;
        document.title = `Sijo Sam — Resume (${variantConfig[v].label})`;
        history.replaceState(null, '', `#${v}`);
    }

    tabs.forEach((tab) => {
        tab.addEventListener('click', () => selectVariant(tab.dataset.variantTab));
    });

    // Re-select on back/forward or manual hash edits (Astro's ClientRouter
    // swaps pages without re-running this script).
    window.addEventListener('hashchange', () => {
        const h = window.location.hash.slice(1);
        if (['fullstack', 'fe', 'be'].includes(h)) selectVariant(h);
    });

    const hash = window.location.hash.slice(1);
    selectVariant(['fullstack', 'fe', 'be'].includes(hash) ? hash : 'fullstack');
</script>

<style>
    @media print {
        button {
            display: none !important;
        }

        [data-variant-tabs] {
            display: none !important;
        }

        .resume-variant.hidden {
            display: none !important;
        }

        article {
            max-width: 100% !important;
        }
    }
</style>
