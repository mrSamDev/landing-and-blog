---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Footer from '../components/Footer.astro';
import KeyboardEasterEgg from '../components/KeyboardEasterEgg.astro';
import Nav from '../components/Nav.astro';
import PostHog from '../components/PostHog.astro';
import SijoChatWidget from '../components/SijoChatWidget.astro';
import clsx from 'clsx';
import siteConfig from '../data/site-config';

export type Props = HeadProps & { showHeader?: boolean; fullWidth?: boolean; chrome?: boolean };

const { showHeader = true, fullWidth = false, chrome = true, ...head } = Astro.props;
---

<!doctype html>
<html lang="en" class="antialiased break-words" transition:animate="fade">
    <head>
        <BaseHead {...head} />
        <ClientRouter />
        <script is:inline>
            function applyInitialTheme(theme) {
                const isDark = theme === 'dark';
                document.documentElement.classList.toggle('dark', isDark);
                document.documentElement.style.colorScheme = theme;
                // Set data-theme so theme-aware integrations (e.g. mermaid)
                // detect light vs dark reliably instead of falling back to
                // prefers-color-scheme, which would render dark diagrams on a
                // light page when the OS is in dark mode.
                document.documentElement.dataset.theme = theme;
            }
            try {
                const savedTheme = localStorage.getItem('theme');
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                applyInitialTheme(savedTheme || (prefersDark ? 'dark' : 'light'));
            } catch {
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                applyInitialTheme(prefersDark ? 'dark' : 'light');
            }
        </script>

        <PostHog />

        <link rel="alternate" type="application/rss+xml" title={head.title ?? siteConfig.title} href="/rss.xml" />
        <link rel="sitemap" href="/sitemap-index.xml" />
    </head>
    <body class="bg-bg text-ink font-sans antialiased">
        <a
            class="absolute top-4 left-4 z-[5000] py-3 px-4 border-2 border-ink rounded-pill bg-panel-2 text-ink font-extrabold -translate-y-[160%] focus:translate-y-0 transition-transform duration-200"
            href="#main-content"
        >Skip to content</a>
        <div class="flex flex-col min-h-screen px-4 md:px-8">
            {chrome && <Nav />}

            <main id="main-content" class={clsx('grow w-full', !fullWidth && 'max-w-5xl mx-auto')}>
                <slot />
            </main>
            {chrome && <Footer />}
        </div>
        <CommandPalette />
        <KeyboardEasterEgg />
        <SijoChatWidget />
    </body>
</html>
