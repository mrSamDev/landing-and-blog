---
import { type CollectionEntry } from 'astro:content';
import ArrowRight from '../icons/ArrowRight.astro';

type Props = { project: CollectionEntry<'projects'>; class?: string; headingLevel?: 'h2' | 'h3' };

const { project, class: className, headingLevel = 'h2' } = Astro.props;
const { title, description, tags = [] } = project.data;
const TitleTag = headingLevel;
---

<a
    class:list={[
        'group block p-3 bg-panel-2 border border-ink rounded-lg',
        'shadow-[0_1px_3px_rgb(var(--shadow-rgb)/0.06)] hover:-translate-y-px',
        'hover:shadow-[0_2px_8px_rgb(var(--shadow-rgb)/0.12)] transition',
        className
    ]}
    href={`/projects/${project.id}/`}
>
    <div class="grow">
        <div class="flex items-center gap-1.5 mb-2">
            <span
                class="inline-flex items-center rounded-pill border border-ink px-2 py-[3px] text-[0.68rem] font-extrabold tracking-[0.04em] leading-none bg-bluey text-white"
            >
                Project
            </span>
        </div>

        <TitleTag
            class="font-display font-bold text-lg leading-tight sm:text-xl group-hover:text-pink-cta transition-colors"
        >
            {title}
        </TitleTag>
        {description && <div class="mt-1 text-sm leading-normal">{description}</div>}
        {tags.length > 0 && (
            <div class="mt-2 flex flex-wrap gap-1.5">
                {tags.map((tag) => (
                    <span class="rounded-full bg-current/10 px-2 py-0.5 text-[11px] font-medium uppercase tracking-wider">{tag}</span>
                ))}
            </div>
        )}
    </div>
</a>