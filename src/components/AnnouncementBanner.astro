---

<div class="border-t-2 border-ink">
    <div class="flex items-center justify-center gap-2 w-fit mx-auto px-3 py-1.5">
        <span class="shrink-0 inline-flex items-center px-2 py-0.5 text-[0.6rem] font-extrabold leading-none tracking-wide uppercase text-white bg-pink-cta rounded-pill">
            New
        </span>
        <p class="m-0 text-sm leading-tight text-ink">
            New — check out the{" "}
            <button type="button" id="announcement-open-chat" class="font-extrabold text-pink-cta-deep dark:text-pink-cta underline underline-offset-2 hover:text-pink-cta transition-colors whitespace-nowrap cursor-pointer bg-transparent border-none p-0">
              AI chat bot about my life →
            </button>
        </p>
    </div>
</div>

<script>
    import { $ } from 'domsure';

    (() => {
        const openChat = $.required('#announcement-open-chat');
        const [fabErr, fab] = $.tryRequired('#sijo-ai-fab');
        if (fabErr) return;

        openChat.addEventListener('click', () => fab?.click());
    })();
</script>
