---
import { goldenSpiralSquares } from '../utils/golden-ratio';

// Shell = a golden spiral, reused from the same math module as the reveal.
const shell = goldenSpiralSquares(7);
const shellPath = shell.squares.map((s) => s.arc.d).join(' ');
const SHELL_SCALE = 1.6;
---

<div class="snail" data-snail aria-hidden="true">
    <svg class="snail__art" viewBox="0 0 72 44">
        <!-- Shell: the golden spiral, scaled into the upper-right -->
        <g transform={`translate(34 7) scale(${SHELL_SCALE})`}>
            <path class="snail__shell" d={shellPath} />
        </g>
        <!-- Body: a simple rounded foot -->
        <path
            class="snail__body"
            d="M 2 36 Q 22 28 46 34 Q 49 39 28 39 Q 6 39 2 36 Z"
        />
        <!-- Eye stalks -->
        <path class="snail__stalks" d="M 8 34 L 8 25 M 16 34 L 16 25" />
        <circle class="snail__eye" cx="8" cy="24" r="1.6" />
        <circle class="snail__eye" cx="16" cy="24" r="1.6" />
    </svg>
</div>

<style>
    .snail {
        position: fixed;
        left: 0;
        bottom: 0.75rem;
        z-index: 50;
        width: 3.5rem;
        pointer-events: none;
        will-change: transform;
    }

    .snail__art {
        display: block;
        width: 100%;
        height: auto;
    }

    .snail__shell {
        fill: none;
        stroke: var(--color-ink);
        stroke-width: 0.8;
        stroke-linecap: round;
        opacity: 0.8;
    }

    .snail__body {
        fill: color-mix(in srgb, var(--color-ink) 12%, transparent);
        stroke: var(--color-ink);
        stroke-width: 1;
        stroke-linejoin: round;
        opacity: 0.85;
    }

    .snail__stalks {
        fill: none;
        stroke: var(--color-ink);
        stroke-width: 1.2;
        stroke-linecap: round;
        opacity: 0.85;
    }

    .snail__eye {
        fill: var(--color-ink);
        opacity: 0.9;
    }
</style>

<script>
    (() => {
        const el = document.querySelector('[data-snail]');
        if (!(el instanceof HTMLElement)) return;

        // Static on reduced-motion: no rAF loop, shell still visible.
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            return;
        }

        // Golden-ratio motion: the snail pauses at 0.618 × viewport width for
        // 1.618 seconds before continuing — both pause location and duration
        // are φ-derived.
        const PAUSE_FRACTION = 0.618;
        const PAUSE_MS = 1618;
        const SPEED = 0.4; // px per frame at 60fps
        const PAUSED = 'paused';
        const WALKING = 'walking';

        let x = 0;
        let dir = 1;
        let phase: string = WALKING;
        let pauseUntil = 0;
        let pausedThisPass = false;

        function walk() {
            const maxX = window.innerWidth - el.offsetWidth;

            if (phase === WALKING) {
                x += SPEED * dir;
                if (dir === 1 && !pausedThisPass && x >= PAUSE_FRACTION * maxX) {
                    x = PAUSE_FRACTION * maxX;
                    phase = PAUSED;
                    pausedThisPass = true;
                    pauseUntil = performance.now() + PAUSE_MS;
                } else if (x >= maxX) {
                    x = maxX;
                    dir = -1;
                } else if (dir === -1 && x <= 0) {
                    x = 0;
                    dir = 1;
                    pausedThisPass = false;
                }
            } else if (phase === PAUSED) {
                if (performance.now() >= pauseUntil) {
                    phase = WALKING;
                }
            }

            el.style.transform = `translateX(${x.toFixed(1)}px) scaleX(${dir})`;
            requestAnimationFrame(walk);
        }

        requestAnimationFrame(walk);
    })();
</script>
