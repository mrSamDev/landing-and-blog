---
---

<canvas class="snail-ground" data-snail-ground aria-hidden="true"></canvas>
<div class="snail" data-snail aria-hidden="true">
    <canvas class="snail__canvas"></canvas>
</div>

<style>
    .snail {
        position: fixed;
        left: 0;
        bottom: 1.5rem;
        z-index: 50;
        width: 5.5rem;
        pointer-events: none;
        will-change: transform;
        opacity: 0;
        transition: opacity 0.5s ease;
    }

    .snail__canvas {
        display: block;
        width: 100%;
        height: auto;
    }

    .snail-ground {
        position: fixed;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 2.25rem;
        z-index: 49;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.6s ease;
    }

    .snail-ground.is-visible {
        opacity: 1;
    }
</style>

<script>
    // Draw a small garden snail on canvas: a glossy spiral shell (golden/log
    // spiral), a soft shaded foot, and eye tentacles. Faces left.
    (() => {
        const el = document.querySelector<HTMLElement>('[data-snail]') as HTMLElement;
        const canvas = el?.querySelector<HTMLCanvasElement>('canvas') as HTMLCanvasElement;
        if (!el || !canvas) {
            return;
        }

        const W = 88; // logical art size (px)
        const H = 56;
        const dpr = window.devicePixelRatio || 1;
        canvas.width = W * dpr;
        canvas.height = H * dpr;
        const ctx = canvas.getContext('2d') as CanvasRenderingContext2D;
        if (!ctx) return;
        ctx.scale(dpr, dpr);

        const PHI = (1 + Math.sqrt(5)) / 2;

        // --- golden (logarithmic) spiral points, normalized to radius R ---
        function spiralPoints(cx: number, cy: number, R: number, turns: number) {
            const pts = [];
            const steps = Math.floor(turns * 40);
            let maxR = 0;
            const raw = [];
            for (let i = 0; i <= steps; i++) {
                const t = (i / steps) * turns * 2 * Math.PI;
                const r = Math.pow(PHI, t / Math.PI); // grows by φ² each turn
                raw.push([t, r]);
                if (r > maxR) maxR = r;
            }
            for (const [t, r] of raw) {
                const nr = (r / maxR) * R;
                pts.push([cx + nr * Math.cos(t), cy + nr * Math.sin(t)]);
            }
            return pts;
        }

        function draw() {
            ctx.clearRect(0, 0, W, H);

            // slime trail (behind, to the right of the shell)
            ctx.fillStyle = 'rgba(180, 196, 168, 0.35)';
            ctx.beginPath();
            ctx.ellipse(80, 47, 14, 3.5, 0, 0, Math.PI * 2);
            ctx.fill();

            // contact shadow under the foot (bridges to the ground strip)
            ctx.fillStyle = 'rgba(60, 40, 20, 0.18)';
            ctx.beginPath();
            ctx.ellipse(40, 52, 32, 3.5, 0, 0, Math.PI * 2);
            ctx.fill();

            // --- body / foot ---
            const footGrad = ctx.createLinearGradient(0, 26, 0, 54);
            footGrad.addColorStop(0, '#ecd9b2');
            footGrad.addColorStop(1, '#c9af83');
            ctx.fillStyle = footGrad;
            ctx.strokeStyle = 'rgba(90, 62, 34, 0.45)';
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(5, 40);
            ctx.quadraticCurveTo(3, 51, 20, 52); // tail, under
            ctx.quadraticCurveTo(44, 54, 66, 51); // belly under shell
            ctx.quadraticCurveTo(74, 49, 70, 42); // back under shell
            ctx.quadraticCurveTo(52, 30, 24, 34); // top of body toward head
            ctx.quadraticCurveTo(10, 36, 5, 40);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();

            // --- shell (drawn over the rear of the body) ---
            const sx = 52;
            const sy = 25;
            const R = 19;
            const shellGrad = ctx.createRadialGradient(sx - 5, sy - 6, 2, sx, sy, R);
            shellGrad.addColorStop(0, '#e3bb82');
            shellGrad.addColorStop(0.55, '#c08a4f');
            shellGrad.addColorStop(1, '#7c4f28');
            ctx.fillStyle = shellGrad;
            ctx.beginPath();
            ctx.arc(sx, sy, R, 0, Math.PI * 2);
            ctx.fill();
            // spiral seam / growth lines
            ctx.strokeStyle = 'rgba(86, 52, 26, 0.7)';
            ctx.lineWidth = 1.1;
            ctx.beginPath();
            const pts = spiralPoints(sx, sy, R, 2.4);
            pts.forEach((p, i) => (i === 0 ? ctx.moveTo(p[0], p[1]) : ctx.lineTo(p[0], p[1])));
            ctx.stroke();
            // rim + glossy highlight
            ctx.strokeStyle = 'rgba(70, 40, 18, 0.55)';
            ctx.lineWidth = 1.2;
            ctx.beginPath();
            ctx.arc(sx, sy, R - 0.5, -0.4, 4.4);
            ctx.stroke();
            ctx.fillStyle = 'rgba(255, 244, 220, 0.45)';
            ctx.beginPath();
            ctx.ellipse(sx - 6, sy - 8, 5.5, 3, -0.5, 0, Math.PI * 2);
            ctx.fill();

            // --- eye tentacles (front, left) ---
            ctx.strokeStyle = 'rgba(150, 112, 70, 0.9)';
            ctx.lineWidth = 2.6;
            ctx.lineCap = 'round';
            ctx.beginPath();
            ctx.moveTo(13, 32);
            ctx.quadraticCurveTo(9, 22, 11, 15);
            ctx.moveTo(24, 30);
            ctx.quadraticCurveTo(22, 20, 25, 14);
            ctx.stroke();
            // eyes + glints
            ctx.fillStyle = '#2e2014';
            ctx.beginPath();
            ctx.arc(11, 15, 2.4, 0, Math.PI * 2);
            ctx.arc(25, 14, 2.4, 0, Math.PI * 2);
            ctx.fill();
            ctx.fillStyle = '#fff';
            ctx.beginPath();
            ctx.arc(10.3, 14.2, 0.8, 0, Math.PI * 2);
            ctx.arc(24.3, 13.2, 0.8, 0, Math.PI * 2);
            ctx.fill();
        }

        draw();

        // --- ground: a full-width strip of textured soil (canvas) ---
        const ground = document.querySelector<HTMLCanvasElement>('[data-snail-ground]') as HTMLCanvasElement;
        const GROUND_H = 36; // logical px (~2.25rem)

        function mulberry32(a: number) {
            return function () {
                a |= 0;
                a = (a + 0x6d2b79f5) | 0;
                let t = Math.imul(a ^ (a >>> 15), 1 | a);
                t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
                return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
            };
        }

        function drawSoil(g: CanvasRenderingContext2D, W: number, H: number) {
            g.clearRect(0, 0, W, H);
            const grad = g.createLinearGradient(0, 0, 0, H);
            grad.addColorStop(0, 'rgba(163,118,62,0)');
            grad.addColorStop(0.2, 'rgba(163,118,62,0.4)');
            grad.addColorStop(0.5, 'rgba(122,82,42,0.8)');
            grad.addColorStop(1, 'rgba(82,52,26,0.95)');
            g.fillStyle = grad;
            g.fillRect(0, 0, W, H);

            // deterministic texture so it doesn't flicker on resize
            const rand = mulberry32(1618);
            const dark = Math.floor(W / 6);
            for (let i = 0; i < dark; i++) {
                const x = rand() * W;
                const y = rand() * H;
                const r = 0.5 + rand() * 1.6;
                const a = 0.15 + rand() * 0.25;
                g.fillStyle = `rgba(55,32,16,${a.toFixed(3)})`;
                g.beginPath();
                g.arc(x, y, r, 0, Math.PI * 2);
                g.fill();
            }
            const light = Math.floor(W / 10);
            for (let i = 0; i < light; i++) {
                const x = rand() * W;
                const y = rand() * H;
                const r = 0.6 + rand() * 1.2;
                const a = 0.12 + rand() * 0.2;
                g.fillStyle = `rgba(200,152,94,${a.toFixed(3)})`;
                g.beginPath();
                g.arc(x, y, r, 0, Math.PI * 2);
                g.fill();
            }
            const pebbles = Math.floor(W / 40);
            for (let i = 0; i < pebbles; i++) {
                const x = rand() * W;
                const y = H * 0.45 + rand() * H * 0.55;
                const r = 1.2 + rand() * 2;
                const a = 0.3 + rand() * 0.25;
                g.fillStyle = `rgba(70,44,24,${a.toFixed(3)})`;
                g.beginPath();
                g.arc(x, y, r, 0, Math.PI * 2);
                g.fill();
            }

            // grass blades along the top edge, where ground meets the page
            const grassRand = mulberry32(233);
            const blades = Math.floor(W / 4);
            for (let i = 0; i < blades; i++) {
                const x = (i + 0.5) * (W / blades) + (grassRand() - 0.5) * 3;
                const h = 3 + grassRand() * 6;
                const lean = (grassRand() - 0.5) * 3;
                g.strokeStyle = grassRand() > 0.5 ? 'rgba(88,128,56,0.6)' : 'rgba(70,112,46,0.6)';
                g.lineWidth = 1;
                g.beginPath();
                g.moveTo(x, 9);
                g.quadraticCurveTo(x + lean * 0.5, 9 - h * 0.6, x + lean, 9 - h);
                g.stroke();
            }
            // soft top edge
            g.fillStyle = 'rgba(60,35,18,0.18)';
            g.fillRect(0, 1, W, 2);
        }

        function sizeGround() {
            if (!ground) return;
            const gw = Math.ceil(window.innerWidth * dpr);
            const gh = Math.ceil(GROUND_H * dpr);
            if (ground.width !== gw || ground.height !== gh) {
                ground.width = gw;
                ground.height = gh;
            }
            const g = ground.getContext('2d') as CanvasRenderingContext2D;
            g.setTransform(1, 0, 0, 1, 0, 0);
            g.scale(dpr, dpr);
            drawSoil(g, window.innerWidth, GROUND_H);
        }
        sizeGround();
        window.addEventListener('resize', sizeGround);

        // Hidden until the visitor double-clicks the large site name (a
        // delegated trigger so it survives view transitions).
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const PAUSE_FRACTION = 0.618;
        const PAUSE_MS = 1618;
        const SPEED_PX_PER_SECOND = 28;
        const PAUSED = 'paused';
        const WALKING = 'walking';

        let snailW = 0;
        function measure() {
            snailW = el.offsetWidth;
        }
        measure();
        window.addEventListener('resize', measure);

        let x = 0;
        let dir = 1;
        let phase = WALKING;
        let pauseUntil = 0;
        let pausedThisPass = false;
        let lastTs = 0;
        let crawling = false;

        function walk(ts: number) {
            const maxX = window.innerWidth - snailW;
            const dt = Math.min((ts - lastTs) / 1000, 0.1);
            lastTs = ts;

            if (phase === WALKING) {
                x += SPEED_PX_PER_SECOND * dt * dir;
                if (dir === 1 && !pausedThisPass && x >= PAUSE_FRACTION * maxX) {
                    x = PAUSE_FRACTION * maxX;
                    phase = PAUSED;
                    pausedThisPass = true;
                    pauseUntil = performance.now() + PAUSE_MS;
                } else if (x >= maxX) {
                    x = maxX;
                    dir = -1;
                } else if (dir === -1 && x <= 0) {
                    x = 0;
                    dir = 1;
                    pausedThisPass = false;
                }
            } else if (phase === PAUSED) {
                if (performance.now() >= pauseUntil) {
                    phase = WALKING;
                }
            }

            // The art faces left; flip to face the travel direction.
            el.style.transform = `translateX(${x.toFixed(1)}px) scaleX(${-dir})`;
            requestAnimationFrame(walk);
        }

        function reveal() {
            el.style.opacity = '1';
            const ground = document.querySelector('[data-snail-ground]');
            if (ground instanceof HTMLElement) {
                ground.classList.add('is-visible');
            }
            if (reduce) return; // static snail under reduced motion
            if (crawling) return;
            crawling = true;
            x = 0;
            dir = 1;
            phase = WALKING;
            pausedThisPass = false;
            el.style.transform = '';
            requestAnimationFrame(walk);
        }

        document.addEventListener('dblclick', (e) => {
            if (e.target instanceof Element && e.target.closest('[data-mascot-trigger]')) {
                reveal();
            }
        });
    })();
</script>
