---
import siteConfig from '../data/site-config';

const hero = siteConfig.hero;
---

{
    hero?.text && (
        <section class="mt-12 sm:mt-20 mb-24 sm:mb-36">
            <div class="max-w-3xl">
                <p class="font-display font-bold text-3xl sm:text-5xl lg:text-6xl leading-[1.25] text-ink" data-mascot-trigger>
                    {hero.text}
                </p>

                {hero.subtitle && (
                    <p class="mt-6 sm:mt-8 text-base sm:text-lg text-ink/55 leading-relaxed max-w-xl">
                        {hero.subtitle}
                    </p>
                )}

                {hero.title && (
                    <div class="mt-10 sm:mt-14">
                        <p class="text-sm tracking-wide text-ink/70 font-display">
                            — {hero.title}
                        </p>
                        {siteConfig.subtitle && (
                            <p class="mt-1 text-xs tracking-[0.2em] uppercase text-ink/45">
                                {siteConfig.subtitle}
                            </p>
                        )}
                    </div>
                )}
            </div>
        </section>
    )
}