---
/*
 * Trapezoid-style tag (slanted parallelogram) — keeps the 1px ink border
 * that defines this design system by using skewX on the shell and an
 * inverse skewX on the text so it stays upright and readable.
 *
 *   <Tag text="Astro" />                      → subtle neutral chip
 *   <Tag text="Astro" href="/tags/astro" />   → linkable
 *   <Tag text="Astro" color="pink" />         → solid accent
 */
type Color = 'surface' | 'pink' | 'bluey' | 'mint' | 'yellow';

type Props = {
    text: string;
    href?: string;
    color?: Color;
    class?: string;
};

const { text, href, color = 'surface', class: className } = Astro.props;
const Tag = href ? 'a' : 'span';

const isAccent = color !== 'surface';
const colorClasses: Record<Color, string> = {
    surface: 'bg-surface text-ink',
    pink: 'bg-pink text-white',
    bluey: 'bg-bluey text-white',
    mint: 'bg-mint text-ink',
    yellow: 'bg-yellow text-ink'
};
---

<Tag
    href={href}
    class:list={[
        'inline-flex skew-x-[-12deg] items-center border border-ink rounded-[2px]',
        'px-2.5 py-[3px] text-[11px] font-bold uppercase tracking-wider leading-none',
        colorClasses[color],
        isAccent && 'shadow-[0_1px_0_rgb(var(--shadow-rgb)/0.12)]',
        className
    ]}
>
    <span class="inline-block skew-x-[12deg]">{text}</span>
</Tag>