---
import siteConfig from '../data/site-config';

interface Props {
    includeRss?: boolean;
    variant?: 'icon' | 'text';
    iconClass?: string;
    anchorClass?: string;
}

const {
    includeRss = false,
    variant = 'icon',
    iconClass = 'w-5 h-5 fill-current',
    anchorClass = 'inline-flex items-center justify-center text-ink/70 hover:text-ink transition-colors'
} = Astro.props;
const socialLinks = siteConfig.socialLinks || [];
---

{
    socialLinks.length > 0 && variant === 'text' && (
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-display tracking-wide text-ink/45">
            {socialLinks.map((link, index) => (
                <Fragment>
                    <a
                        class="hover:text-ink/80 transition-colors"
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-link={link.text}
                    >
                        {link.text}
                    </a>
                    {index < socialLinks.length - 1 && <span aria-hidden="true">·</span>}
                </Fragment>
            ))}
            {includeRss && (
                <Fragment>
                    <span aria-hidden="true">·</span>
                    <a class="hover:text-ink/80 transition-colors" href="/rss.xml" target="_blank" rel="noopener noreferrer" data-link="RSS">
                        RSS
                    </a>
                </Fragment>
            )}
        </div>
    )
}

{
    socialLinks.length > 0 && variant === 'icon' && (
        <div class="flex flex-wrap gap-x-3 gap-y-2 items-center">
            {socialLinks.map((link) => {
                const label = link.text;
                let icon;
                if (label === 'LinkedIn') {
                    icon = <svg viewBox="0 0 24 24" aria-hidden="true" class={iconClass}><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.37-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" /></svg>;
                } else if (label === 'GitHub') {
                    icon = <svg viewBox="0 0 24 24" aria-hidden="true" class={iconClass}><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.79 2.73 1.27 3.4.97.1-.76.41-1.27.74-1.56-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.41-5.25 5.69.42.36.8 1.08.8 2.18v3.23c0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" /></svg>;
                } else if (label === 'Email') {
                    icon = <svg viewBox="0 0 24 24" aria-hidden="true" class={iconClass}><path d="M2 4h20a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm0 2v.5l10 6 10-6V6H2zm0 2.5V18h20V8.5l-10 6-10-6z" /></svg>;
                } else if (label === 'BlueSky') {
                    icon = <svg viewBox="0 0 600 530" aria-hidden="true" class={iconClass}><path d="m135.72 44.03c66.496 49.921 138.02 151.14 164.28 205.46 26.262-54.316 97.782-155.54 164.28-205.46 47.98-36.021 125.72-63.892 125.72 24.795 0 17.712-10.155 148.79-16.111 170.07-20.703 73.984-96.144 92.854-163.25 81.433 117.3 19.964 147.14 86.092 82.697 152.22-122.39 125.59-175.91-31.511-189.63-71.766-2.514-7.3797-3.6904-10.832-3.7077-7.8964-0.0174-2.9357-1.1937 0.51669-3.7077 7.8964-13.714 40.255-67.233 197.36-189.63 71.766-64.444-66.128-34.605-132.26 82.697-152.22-67.108 11.421-142.55-7.4491-163.25-81.433-5.9562-21.282-16.111-152.36-16.111-170.07 0-88.687 77.742-60.816 125.72-24.795z" /></svg>;
                } else {
                    icon = <span class="text-sm">{label}</span>;
                }
                return (
                    <a
                        class={anchorClass}
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={label}
                        data-link={label}
                    >
                        {icon}
                    </a>
                );
            })}
            {includeRss && (
                <a
                    class={anchorClass}
                    href="/rss.xml"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="RSS feed"
                    data-link="RSS"
                >
                    <svg viewBox="0 0 24 24" aria-hidden="true" class={iconClass}>
                        <path d="M6.18 15.64a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36zM4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44zm0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z" />
                    </svg>
                </a>
            )}
        </div>
    )
}