---
interface Props {
    theme?: 'github-light' | 'github-dark' | 'preferred-color-scheme';
    label?: string;
    issueTerm?: string;
}

const { theme = 'github-dark', label = 'comments', issueTerm = 'pathname' } = Astro.props;
---

<div id="utterances-container" data-theme={theme} data-label={label} data-issue-term={issueTerm}></div>

<script>
    import { $ } from 'domsure';

    function initUtterances() {
        const container = $('#utterances-container');
        if (!container) return;

        const theme = container.getAttribute('data-theme') || 'github-dark';
        const label = container.getAttribute('data-label') || 'comments';
        const issueTerm = container.getAttribute('data-issue-term') || 'pathname';

        function loadUtterances(target: HTMLElement) {
            try {
                const existingScript = $('#utterances-script');
                existingScript?.remove();

                const script = document.createElement('script');
                target.innerHTML = '';

                const config = {
                    src: 'https://utteranc.es/client.js',
                    repo: 'mrSamDev/landing-and-blog',
                    'issue-term': issueTerm,
                    label: label,
                    theme: theme,
                    crossorigin: 'anonymous'
                };

                Object.entries(config).forEach(([key, value]) => {
                    script.setAttribute(key, String(value));
                });

                script.id = 'utterances-script';

                script.onerror = () => {
                    target.innerHTML = 'Error loading comments. Please check your configuration.';
                };

                target.appendChild(script);
            } catch (error) {
                console.error('Error initializing Utterances:', error);
            }
        }

        loadUtterances(container);

        const observer = new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
                if (mutation.type === 'attributes' && mutation.attributeName === 'data-theme') {
                    loadUtterances(container);
                }
            });
        });

        observer.observe(container, { attributes: true });
    }

    document.addEventListener('astro:page-load', initUtterances);
</script>

<style>
    #utterances-container {
        margin: 2rem 0;
        width: 100%;
        min-height: 200px;
        transition: opacity 0.3s ease;
    }

    #utterances-container:empty::before {
        content: 'Loading comments...';
        display: block;
        text-align: center;
        padding: 2rem;
        color: #666;
        font-style: italic;
    }
</style>
