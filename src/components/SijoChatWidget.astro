---
/**
 * SijoChatWidget — a floating chat bubble (bottom-right) that opens a panel
 * containing the self-contained Sijo AI widget bundle.
 *
 * The widget itself has no built-in floating button (per the integration
 * guide), so this component owns the bubble + panel chrome and mounts the
 * compiled IIFE bundle (`/widget.js`) into a container via the DOM API
 * (`window.SijoAIWidget.mount). The bundle is lazy-loaded on first open so
 * the ~640 KB cost isn't paid on every page load.
 *
 * `transition:persist` keeps the widget (and its open/closed + chat state)
 * alive across Astro view-transition navigations.
 *
 * Styling uses the site's Tailwind theme tokens (bg-panel-2, border-ink,
 * from-pink-cta, font-display, rounded-pill, …). Open/closed state is driven
 * by the `data-open` attribute on the root, targeted via Tailwind's
 * `group` + `group-data-[open=true]:` variants.
 *
 * Backend: the RAG API server (Bun + Hono) on http://localhost:3001, whose
 * CORS allows any localhost origin, so the widget can call ${API_BASE}/chat
 * cross-origin from this site.
 */
const API_BASE = 'http://localhost:3001/api';
---

<div
    id="sijo-ai-float"
    class="group fixed bottom-5 right-5 z-[9999] font-display max-[30rem]:bottom-4 max-[30rem]:right-4"
    transition:persist
    data-open="false"
    data-api-base={API_BASE}
>
    <div
        id="sijo-ai-panel"
        class="absolute bottom-[calc(3.5rem+0.75rem)] right-0 flex w-[min(24rem,calc(100vw-2.5rem))] h-[min(40rem,calc(100dvh-6rem))] flex-col overflow-hidden rounded-2xl border-2 border-ink bg-panel-2 shadow-[0_18px_50px_-12px_rgb(var(--shadow-rgb)_/_0.5)] opacity-0 translate-y-3 scale-[0.98] pointer-events-none transition-[opacity,transform] duration-[160ms] ease-out group-data-[open=true]:opacity-100 group-data-[open=true]:translate-y-0 group-data-[open=true]:scale-100 group-data-[open=true]:pointer-events-auto max-[30rem]:w-[calc(100vw-2rem)] max-[30rem]:h-[calc(100dvh-5.5rem)] motion-reduce:transition-none"
        role="dialog"
        aria-label="Sijo AI chat"
        aria-modal="false"
        hidden
    >
        <div id="sijo-ai-mount" class="flex min-h-0 flex-1 flex-col"></div>
    </div>

    <button
        id="sijo-ai-fab"
        class="relative inline-flex h-14 w-14 items-center justify-center rounded-pill border-none bg-linear-to-b from-pink-cta to-pink-cta-deep text-white cursor-pointer shadow-[0_6px_18px_-4px_rgb(var(--shadow-rgb)_/_0.45)] transition-[transform,box-shadow] duration-[160ms] ease-out hover:-translate-y-0.5 hover:shadow-[0_10px_24px_-6px_rgb(var(--shadow-rgb)_/_0.55)] active:translate-y-0 focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-pink-cta focus-visible:outline-offset-[3px] motion-reduce:transition-none"
        type="button"
        aria-label="Open Sijo AI assistant"
        aria-expanded="false"
        aria-controls="sijo-ai-panel"
    >
        <svg class="sijo-ai-fab__icon sijo-ai-fab__icon--chat inline-flex group-data-[open=true]:hidden" width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 2.5l1.9 5.1 5.1 1.9-5.1 1.9L12 16.5l-1.9-5.1L5 9.5l5.1-1.9L12 2.5Z" fill="currentColor" />
            <path d="M19 13.5l.9 2.4 2.4.9-2.4.9-.9 2.4-.9-2.4-2.4-.9 2.4-.9.9-2.4Z" fill="currentColor" opacity="0.75" />
            <path d="M5 14.5l.6 1.6 1.6.6-1.6.6-.6 1.6-.6-1.6-1.6-.6 1.6-.6.6-1.6Z" fill="currentColor" opacity="0.5" />
        </svg>
        <svg class="sijo-ai-fab__icon sijo-ai-fab__icon--close hidden group-data-[open=true]:inline-flex" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
    </button>
</div>

<script>
    import { $ } from 'domsure';

    // These elements are guaranteed by the markup above; fail loud if any is missing.
    const root = $.required('#sijo-ai-float');
    // Guard against double-init when Astro view transitions re-run hoisted scripts.
    if (root.dataset.ready === '1') {
        // Already wired (persisted element kept its listeners). Nothing to do.
    } else {
        root.dataset.ready = '1';

        const fab = $.required('#sijo-ai-fab');
        const panel = $.required('#sijo-ai-panel');
        const mount = $.required('#sijo-ai-mount');
        const API_BASE = root.dataset.apiBase || '/api';
        const SCRIPT_SRC = '/widget.js';
        const SCRIPT_ID = 'sijo-ai-widget-bundle';
        let mounted = false;

        /** Load the widget bundle once; resolve when the global is ready. */
        function loadBundle(): Promise<void> {
            return new Promise<void>((resolve, reject) => {
                const W = window;
                if (W.SijoAIWidget && typeof W.SijoAIWidget.mount === 'function') {
                    resolve();
                    return;
                }
                // Silent query — the bundle script may not exist yet on first open.
                let s = $('#' + SCRIPT_ID) as HTMLScriptElement | null;
                if (!s) {
                    s = document.createElement('script');
                    s.id = SCRIPT_ID;
                    s.src = SCRIPT_SRC;
                    s.async = true;
                    document.head.appendChild(s);
                }
                s.addEventListener('load', () => resolve(), { once: true });
                s.addEventListener(
                    'error',
                    () => reject(new Error('Failed to load ' + SCRIPT_SRC)),
                    { once: true }
                );
            });
        }

        function setOpen(open: boolean) {
            root.dataset.open = open ? 'true' : 'false';
            fab.setAttribute('aria-expanded', open ? 'true' : 'false');
            fab.setAttribute('aria-label', open ? 'Close Sijo AI assistant' : 'Open Sijo AI assistant');
        }

        function open() {
            panel.hidden = false; // ensure visible before first animate
            setOpen(true);
            if (mounted) return;
            loadBundle()
                .then(() => {
                    const W = window;
                    if (!W.SijoAIWidget || typeof W.SijoAIWidget.mount !== 'function') {
                        console.error('[sijo-ai] bundle loaded but SijoAIWidget.mount missing');
                        return;
                    }
                    W.SijoAIWidget.mount(mount, {
                        apiBase: API_BASE,
                        showHeader: true,
                        showThemeToggle: true
                    });
                    mounted = true;
                })
                .catch((err) => console.error('[sijo-ai]', err));
        }

        function close() {
            setOpen(false);
        }

        fab.addEventListener('click', () => {
            if (root.dataset.open === 'true') close();
            else open();
        });

        // Close on Escape.
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && root.dataset.open === 'true') close();
        });
    }
</script>