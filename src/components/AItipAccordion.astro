---
import { type CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Button from './Button.astro';

type Props = { post: CollectionEntry<'aitips'> };
const { post } = Astro.props;
const { Content } = await render(post);
const postBody = post.body || '';
const postKey = post.data.key || `tip-${post.id}`;
---

<style>
    summary::-webkit-details-marker {
        display: none;
    }

    .accordion-content {
        max-height: 0;
        overflow: hidden;
        transition:
            max-height 0.3s ease-out,
            opacity 0.2s ease-out;
        opacity: 0;
        max-width: unset !important;
    }

    details[open] .accordion-content {
        max-height: 500px;
        opacity: 1;
        overflow-y: auto;
    }
</style>

<details id={postKey} class="group border border-ink/25 rounded-lg bg-panel-2 shadow-[0_1px_3px_rgb(var(--shadow-rgb)/0.06)] hover:-translate-y-px hover:shadow-[0_2px_8px_rgb(var(--shadow-rgb)/0.12)] transition w-full">
    <summary class="p-3 cursor-pointer flex justify-between items-center gap-2 list-none">
        <h2 class="font-display font-bold text-base md:text-lg leading-tight truncate">{post.data.title}</h2>
        <div class="flex items-center gap-2 shrink-0">
            <Button id={'copy-button-' + postKey} data-ai-tip-key={postKey} data-ai-tip-body={postBody}>Copy</Button>
            <span class="text-ink/60 transition-transform duration-200 group-open:rotate-180">&#9660;</span>
        </div>
    </summary>

    <div class="accordion-content p-3 pt-0 prose prose-sijo prose-sm sm:prose-base w-full">
        <Content />
        {
            post.data.reference && (
                <div class="mt-4 text-sm text-ink/60">
                    Original post:{' '}
                    <a href={post.data.reference} target="_blank" rel="noopener noreferrer" class="text-link underline hover:no-underline">
                        Read here
                    </a>
                </div>
            )
        }
    </div>
</details>

<script>
    import { $, $$ } from 'domsure';

    const bound = new WeakSet<HTMLElement>();

    function initAiTipAccordions() {
        for (const copyButton of $$('[data-ai-tip-key]')) {
            const postKey = copyButton.getAttribute('data-ai-tip-key') || '';
            const postBody = copyButton.getAttribute('data-ai-tip-body') || '';
            const accordion = $('#' + postKey);

            if (window.location.hash === '#' + postKey && accordion instanceof HTMLDetailsElement) {
                accordion.open = true;
            }

            if (bound.has(copyButton)) continue;
            bound.add(copyButton);

            copyButton.addEventListener('click', (event) => {
                event.preventDefault();
                event.stopPropagation();
                const accordionContent = accordion?.querySelector('.accordion-content');
                if (accordionContent) {
                    navigator.clipboard
                        .writeText(postBody)
                        .then(() => {
                            const originalText = copyButton.innerText;
                            copyButton.innerText = 'Copied';
                            setTimeout(() => {
                                copyButton.innerText = originalText;
                            }, 1000);
                        })
                        .catch((err) => {
                            console.error('Failed to copy:', err);
                        });
                } else {
                    console.error('Accordion content not found');
                }
            });
        }
    }

    document.addEventListener('astro:page-load', initAiTipAccordions);
</script>
