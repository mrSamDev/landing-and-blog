---
import { type CollectionEntry } from 'astro:content';
import ArrowRight from '../icons/ArrowRight.astro';
import FormattedDate from './FormattedDate.astro';

type Props = { post: CollectionEntry<'blog' | 'guides'>; class?: string; headingLevel?: 'h2' | 'h3'; isGuide?: boolean };

const { post, class: className, isGuide = false } = Astro.props;
const { title, publishDate, updatedDate, excerpt } = post.data;
---

<a
    class:list={[
        'group block p-3 bg-panel-2 border border-ink/25 rounded-lg',
        'shadow-[0_1px_3px_rgb(var(--shadow-rgb)/0.06)] hover:-translate-y-px',
        'hover:shadow-[0_2px_8px_rgb(var(--shadow-rgb)/0.12)] transition',
        className
    ]}
    href={isGuide ? `/guides/${post.id}/` : `/blog/${post.id}/`}
>
    <div class="grow">
        <div class="flex items-center gap-1.5 mb-2">
            <span
                class="inline-flex items-center rounded-pill px-2 py-[3px] text-[0.68rem] font-extrabold tracking-[0.04em] leading-none bg-pink text-white"
            >
                {isGuide ? 'Guide' : 'Article'}
            </span>
            <span
                class="inline-flex items-center rounded-pill border border-ink/15 px-2 py-[3px] text-[0.68rem] font-extrabold tracking-[0.04em] leading-none bg-surface text-ink"
            >
                <FormattedDate date={publishDate} />
            </span>
            {
                updatedDate && (
                    <span
                        class="inline-flex items-center rounded-pill border border-ink/15 px-2 py-[3px] text-[0.68rem] font-extrabold tracking-[0.04em] leading-none bg-surface text-ink"
                    >
                        Updated <FormattedDate date={updatedDate} />
                    </span>
                )
            }
        </div>

        <h2
            class="font-display font-bold text-lg leading-tight sm:text-xl group-hover:text-pink-cta transition-colors"
        >
            {title}
        </h2>

        {excerpt && <p class="mt-2 text-sm leading-normal text-ink/80 line-clamp-2">{excerpt}</p>}

        <div
            class="mt-3 hidden sm:inline-flex sm:gap-1 sm:items-center sm:shrink-0 text-sm font-bold text-pink-cta opacity-0 transition group-hover:opacity-100"
        >
            Read Post <ArrowRight class="fill-current w-4 h-4" />
        </div>
    </div>
</a>